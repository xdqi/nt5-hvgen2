LANGUAGE 9, 1
1 VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEFLAGSMASK   0x3F
FILEFLAGS       0
FILEOS          0x40004     /* VOS_NT_WINDOWS32 */
FILETYPE        1           /* VFT_APP */
FILESUBTYPE     0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "nt5-hvgen2"
            VALUE "FileDescription",  "Host tray application for the vmbaud virtual sound card"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "vmbaudtray.exe"
            VALUE "LegalCopyright",   "Distributed under the MS-PL"
            VALUE "OriginalFilename", "vmbaudtray.exe"
            VALUE "ProductName",      "nt5-hvgen2"
            VALUE "ProductVersion",   "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
