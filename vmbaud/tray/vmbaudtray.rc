/* Resources for vmbaudtray.exe.
 *
 * UTF-8 (the Chinese string table); the Makefile compiles it with
 * llvm-rc /C 65001.  Window styles are numeric (windows.h is not included).
 *
 * Distributed under the MS-PL; see LICENSE in the vmbaud directory.
 */
#include "resource.h"

IDI_APP ICON "vmbaud/tray/vmbaudtray.ico"
1 24 "vmbaud/tray/vmbaudtray.manifest"

/* DS_SETFONT|WS_POPUP|WS_CAPTION|WS_SYSMENU|WS_THICKFRAME|WS_MINIMIZEBOX|
 * WS_MAXIMIZEBOX = 0x40|0x80000000|0x00C00000|0x00080000|0x00040000|
 * 0x00020000|0x00010000 = 0x80CF0040.  Resizable: trayui.cpp moves the
 * controls; this is the smallest size. */
IDD_SETTINGS DIALOGEX 0, 0, 300, 222
STYLE 0x80CF0040
EXSTYLE 0x00040000 /* WS_EX_APPWINDOW */
CAPTION L"vmbaudtray"
FONT 9, "Segoe UI", 0, 0, 1
BEGIN
    /* LVS_REPORT|LVS_SINGLESEL|LVS_SHOWSELALWAYS|LVS_NOSORTHEADER|WS_BORDER|WS_TABSTOP */
    CONTROL L"", IDC_LIST, "SysListView32", 0x0081800D,
        7, 7, 286, 150
    /* BS_GROUPBOX; its caption names the VM */
    CONTROL L"", IDC_VOL_LABEL, "Button", 0x00000007,
        7, 162, 286, 34
    /* TBS_HORZ|TBS_NOTICKS|WS_TABSTOP */
    CONTROL L"", IDC_VOLUME, "msctls_trackbar32", 0x00010010,
        12, 175, 206, 14
    CONTROL L"", IDC_VOL_VALUE, "static", 0x00000002 /* SS_RIGHT */,
        220, 178, 24, 9
    /* BS_AUTOCHECKBOX|WS_TABSTOP */
    CONTROL L"", IDC_MUTE, "Button", 0x00010003,
        250, 177, 38, 10
    CONTROL L"", IDC_AUTOSTART, "Button", 0x00010003,
        7, 204, 200, 10
END

/* English (US).  Dialog texts are set at WM_INITDIALOG from here. */
LANGUAGE 9, 1
STRINGTABLE
BEGIN
    IDS_APP_TITLE       L"vmbaudtray"
    IDS_MENU_SETTINGS   L"&Settings..."
    IDS_MENU_AUTOSTART  L"Start with Windows"
    IDS_MENU_EXIT       L"E&xit"
    IDS_COL_NAME        L"Name"
    IDS_COL_STATE       L"State"
    IDS_COL_STATUS      L"Sound"
    IDS_GRP_SOUND       L"Sound on (%d)"
    IDS_GRP_RUNNING     L"Running (%d)"
    IDS_GRP_OFF         L"Off (%d)"
    IDS_STATE_RUNNING   L"Running"
    IDS_STATE_OFF       L"Off"
    IDS_STATE_PAUSED    L"Paused"
    IDS_STATE_SAVED     L"Saved"
    IDS_STATE_STARTING  L"Starting"
    IDS_STATE_STOPPING  L"Stopping"
    IDS_STATE_OTHER     L"Other"
    IDS_ST_OFF          L""
    IDS_ST_WAITVM       L"Waiting for the VM to start"
    IDS_ST_STARTING     L"Starting"
    IDS_ST_WAITIC       L"Waiting for integration services"
    IDS_ST_OFFERING     L"Waiting for the guest driver"
    IDS_ST_CONNECTED    L"Connected"
    IDS_ST_PLAYING      L"Playing, %u Hz"
    IDS_ST_REOFFER      L"Disconnected (error %u), offering again"
    IDS_ST_OFFERFAIL    L"Offer failed (error %u)"
    IDS_ST_NODEVICE     L"Connected, no output device"
    IDS_ST_ERROR        L"Error %u"
    IDS_VOLUME_FOR      L"Volume of %s"
    IDS_VOLUME_HINT     L"Volume (select a VM with sound on)"
    IDS_MUTE            L"Mute"
    IDS_WMI_FAIL        L"Cannot connect to Hyper-V WMI (root\\virtualization\\v2). vmbaudtray will exit."
    IDS_PIPE_FAIL       L"vmbuspiper.dll cannot be loaded (is Hyper-V installed?). vmbaudtray will exit."
    IDS_TIP_NONE        L"vmbaudtray: idle"
    IDS_TIP_ONE         L"vmbaudtray: 1 VM playing"
    IDS_TIP_MANY        L"vmbaudtray: %d VMs playing"
    IDS_ST_BADFORMAT    L"Guest format not supported (%u Hz)"
END

