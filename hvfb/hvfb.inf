; hvfb.inf - installs hvfb.sys on Windows XP as a legacy (non-PnP) display
; miniport driven by the in-box frame buffer display driver framebuf.dll.
;
; There is no PnP device to bind to (Hyper-V Gen2 has no PCI display
; adapter), so this is a DefaultInstall INF that creates a boot-started
; kernel service in the "Video" group, like the in-box VgaSave service.
;
; Install:  right-click hvfb.inf -> Install, or
;           rundll32 setupapi.dll,InstallHinfSection DefaultInstall 132 <dir>\hvfb.inf
; then reboot: VideoPort accepts legacy miniports only before the first
; display device has been opened, i.e. during boot.
;
; Display settings: VideoPort keeps a legacy miniport's device key under
; Control\Video\{VideoID}\0000, VideoID being Services\hvfb\Video\VideoID
; (a new GUID on the first boot unless one exists; the first boot copies
; Device0 there).  The mode comes from the current hardware profile's copy,
; Hardware Profiles\Current\System\CurrentControlSet\Control\Video\{VideoID}\0000,
; which Display Properties updates; the device key's DefaultSettings only
; count until that profile key exists, i.e. for one boot.  So, as XP's
; HIVESYS.INF does for VgaSave, the INF fixes the VideoID and writes both
; keys.  A VideoID or a mode chosen earlier is kept (FLG_ADDREG_NOCLOBBER);
; with an older VideoID the new keys stay unused and the mode is chosen in
; Display Properties as before.

[Version]
Signature   = "$Windows NT$"
Provider    = %Provider%
DriverVer   = 10/06/2026,0.1.0.0

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
hvfb.sys = 1

[DestinationDirs]
DefaultDestDir = 12             ; %SystemRoot%\system32\drivers

[DefaultInstall]
CopyFiles = hvfb.CopyFiles
AddReg    = hvfb.AddReg

[DefaultInstall.Services]
AddService = hvfb, 0, hvfb.Service

[hvfb.CopyFiles]
hvfb.sys

[hvfb.Service]
DisplayName    = %hvfb.ServiceName%
ServiceType    = 1              ; SERVICE_KERNEL_DRIVER
StartType      = 1              ; SERVICE_SYSTEM_START
ErrorControl   = 0              ; SERVICE_ERROR_IGNORE
LoadOrderGroup = Video
ServiceBinary  = %12%\hvfb.sys

; framebuf.dll ships in system32 on every XP installation.  The default
; mode is 1024x768x32, the native mode of Hyper-V Gen2 (smaller modes are
; centred on its 1024x768 screen).  It must be one that hvfb offers, and
; VRefresh must stay 60; other modes can be chosen in Display Properties.
[hvfb.AddReg]
HKLM,"SYSTEM\CurrentControlSet\Services\hvfb\Device0","InstalledDisplayDrivers",0x00010000,"framebuf"
HKLM,"SYSTEM\CurrentControlSet\Services\hvfb\Device0","VgaCompatible",0x00010001,0
HKLM,"SYSTEM\CurrentControlSet\Services\hvfb\Device0","Device Description",0x00000000,%hvfb.DeviceDesc%
HKLM,"SYSTEM\CurrentControlSet\Services\hvfb\Device0","DefaultSettings.XResolution",0x00010001,1024
HKLM,"SYSTEM\CurrentControlSet\Services\hvfb\Device0","DefaultSettings.YResolution",0x00010001,768
HKLM,"SYSTEM\CurrentControlSet\Services\hvfb\Device0","DefaultSettings.BitsPerPel",0x00010001,32
HKLM,"SYSTEM\CurrentControlSet\Services\hvfb\Device0","DefaultSettings.VRefresh",0x00010001,60
HKLM,"SYSTEM\CurrentControlSet\Services\hvfb\Video","VideoID",0x00000002,%hvfb.VideoID%
HKLM,"SYSTEM\CurrentControlSet\Services\hvfb\Video","Service",0x00000000,"hvfb"
HKLM,"SYSTEM\CurrentControlSet\Control\Video\%hvfb.VideoID%\Video","Service",0x00000000,"hvfb"
HKLM,"SYSTEM\CurrentControlSet\Control\Video\%hvfb.VideoID%\0000","InstalledDisplayDrivers",0x00010000,"framebuf"
HKLM,"SYSTEM\CurrentControlSet\Control\Video\%hvfb.VideoID%\0000","VgaCompatible",0x00010001,0
HKLM,"SYSTEM\CurrentControlSet\Control\Video\%hvfb.VideoID%\0000","Device Description",0x00000000,%hvfb.DeviceDesc%
HKLM,"SYSTEM\CurrentControlSet\Control\Video\%hvfb.VideoID%\0000","DefaultSettings.XResolution",0x00010001,1024
HKLM,"SYSTEM\CurrentControlSet\Control\Video\%hvfb.VideoID%\0000","DefaultSettings.YResolution",0x00010001,768
HKLM,"SYSTEM\CurrentControlSet\Control\Video\%hvfb.VideoID%\0000","DefaultSettings.BitsPerPel",0x00010001,32
HKLM,"SYSTEM\CurrentControlSet\Control\Video\%hvfb.VideoID%\0000","DefaultSettings.VRefresh",0x00010001,60
HKLM,"SYSTEM\CurrentControlSet\Hardware Profiles\Current\System\CurrentControlSet\Control\Video\%hvfb.VideoID%\0000","Attach.ToDesktop",0x00010003,1
HKLM,"SYSTEM\CurrentControlSet\Hardware Profiles\Current\System\CurrentControlSet\Control\Video\%hvfb.VideoID%\0000","DefaultSettings.XResolution",0x00010003,1024
HKLM,"SYSTEM\CurrentControlSet\Hardware Profiles\Current\System\CurrentControlSet\Control\Video\%hvfb.VideoID%\0000","DefaultSettings.YResolution",0x00010003,768
HKLM,"SYSTEM\CurrentControlSet\Hardware Profiles\Current\System\CurrentControlSet\Control\Video\%hvfb.VideoID%\0000","DefaultSettings.BitsPerPel",0x00010003,32
HKLM,"SYSTEM\CurrentControlSet\Hardware Profiles\Current\System\CurrentControlSet\Control\Video\%hvfb.VideoID%\0000","DefaultSettings.VRefresh",0x00010003,60

[Strings]
Provider           = "xp-hyperv-gen2"
DiskName           = "hvfb installation files"
hvfb.ServiceName   = "hvfb frame buffer display miniport"
hvfb.DeviceDesc    = "Linear frame buffer display (VBE / Hyper-V Gen2)"
hvfb.VideoID       = "{449ECA2B-4408-4A8C-979B-72B866C035D8}"
